
#include <stdio.h>

int main() {

    double revenue;
    double expenses;
    double balance;

    int departments;
    double payroll;
    double procurement;
    double assets;

    printf("====================================\n");
    printf("      MUNICIPAL BUDGET CALCULATOR\n");
    printf("====================================\n");

    printf("\nEnter Total Revenue: ");
    scanf("%lf", &revenue);

    printf("Enter Total Expenses: ");
    scanf("%lf", &expenses);

    balance = revenue - expenses;

    printf("\n========== BUDGET REPORT ==========\n");
    printf("Revenue  : %.2f\n", revenue);
    printf("Expenses : %.2f\n", expenses);
    printf("Balance  : %.2f\n", balance);

    printf("\n====== MUNICIPAL FINANCIAL DETAILS ======\n");

    printf("Enter Number of Departments: ");
    scanf("%d", &departments);

    printf("Enter Payroll Amount: ");
    scanf("%lf", &payroll);

    printf("Enter Procurement Amount: ");
    scanf("%lf", &procurement);

    printf("Enter Assets Amount: ");
    scanf("%lf", &assets);

    printf("\n======= MUNICIPAL FINANCIAL REPORT =======\n");
    printf("Number of Departments : %d\n", departments);
    printf("Payroll               : %.2f\n", payroll);
    printf("Procurement           : %.2f\n", procurement);
    printf("Assets                : %.2f\n", assets);

    printf("==========================================\n");

    return 0;
}
