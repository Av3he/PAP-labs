
#include <stdio.h>
#include <string.h>

struct Supplier {
    char name[50];
    char email[50];
    char phone[20];
    char town[30];
};

struct Supplier suppliers[5];

int supplierCount = 0;

void displayMenu();
void calculateSalary();
void addSupplier();
void displaySupplier();
void searchSupplier();
void calculateBudget();

int main() {
    int choice;

    do {
        displayMenu();

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                calculateSalary();
                break;

            case 2: {
                int supplierChoice;

                printf("\n===== SUPPLIER MANAGEMENT =====\n");
                printf("1. Add Supplier\n");
                printf("2. Display Suppliers\n");
                printf("3. Search Supplier\n");
                printf("Enter your choice: ");
                scanf("%d", &supplierChoice);

                switch (supplierChoice) {
                    case 1:
                        addSupplier();
                        break;

                    case 2:
                        displaySupplier();
                        break;

                    case 3:
                        searchSupplier();
                        break;

                    default:
                        printf("Invalid supplier choice.\n");
                }
                break;
            }

            case 3:
                calculateBudget();
                break;

            case 4:
                printf("\nThank you for using MFMS!\n");
                break;

            default:
                printf("\nInvalid choice. Try again.\n");
        }

    } while (choice != 4);

    return 0;
}

void displayMenu() {
    printf("\n============================================\n");
    printf(" WINDHOEK MUNICIPAL FINANCIAL MANAGEMENT SYSTEM\n");
    printf("============================================\n");
    printf("1. Employee Management\n");
    printf("2. Supplier Management\n");
    printf("3. Budget Management\n");
    printf("4. Exit\n");
}

void calculateSalary() {
    float basicSalary, housing, transport, tax;
    float grossSalary, netSalary;

    printf("\n===== EMPLOYEE MANAGEMENT =====\n");

    printf("Enter basic salary: ");
    scanf("%f", &basicSalary);

    printf("Enter housing allowance: ");
    scanf("%f", &housing);

    printf("Enter transport allowance: ");
    scanf("%f", &transport);

    printf("Enter tax: ");
    scanf("%f", &tax);

    grossSalary = basicSalary + housing + transport;
    netSalary = grossSalary - tax;

    printf("\nGross Salary: %.2f\n", grossSalary);
    printf("Net Salary: %.2f\n", netSalary);
}

void addSupplier() {
    if (supplierCount >= 5) {
        printf("\nMaximum of 5 suppliers reached.\n");
        return;
    }

    printf("\n===== ADD SUPPLIER =====\n");

    printf("Enter supplier name: ");
    scanf(" %49[^\n]", suppliers[supplierCount].name);

    printf("Enter email: ");
    scanf("%49s", suppliers[supplierCount].email);

    printf("Enter phone: ");
    scanf("%19s", suppliers[supplierCount].phone);

    printf("Enter town: ");
    scanf(" %29[^\n]", suppliers[supplierCount].town);

    supplierCount++;

    printf("\nSupplier added successfully!\n");
}

void displaySupplier() {
    if (supplierCount == 0) {
        printf("\nNo suppliers have been added yet.\n");
        return;
    }

    printf("\n===== SUPPLIER DETAILS =====\n");

    for (int i = 0; i < supplierCount; i++) {
        printf("\nSupplier %d\n", i + 1);
        printf("Name: %s\n", suppliers[i].name);
        printf("Email: %s\n", suppliers[i].email);
        printf("Phone: %s\n", suppliers[i].phone);
        printf("Town: %s\n", suppliers[i].town);
    }
}

void searchSupplier() {
    char searchName[50];
    int found = 0;

    printf("\nEnter supplier name to search: ");
    scanf(" %49[^\n]", searchName);

    for (int i = 0; i < supplierCount; i++) {
        if (strcmp(suppliers[i].name, searchName) == 0) {
            printf("\n===== SUPPLIER FOUND =====\n");
            printf("Name: %s\n", suppliers[i].name);
            printf("Email: %s\n", suppliers[i].email);
            printf("Phone: %s\n", suppliers[i].phone);
            printf("Town: %s\n", suppliers[i].town);

            found = 1;
            break;
        }
    }

    if (found == 0) {
        printf("\nSupplier not found.\n");
    }
}

void calculateBudget() {
    double revenue, expenses, balance;

    printf("\n===== BUDGET MANAGEMENT =====\n");

    printf("Enter total revenue: ");
    scanf("%lf", &revenue);

    printf("Enter total expenses: ");
    scanf("%lf", &expenses);

    balance = revenue - expenses;

    printf("\nTotal Revenue: %.2f\n", revenue);
    printf("Total Expenses: %.2f\n", expenses);
    printf("Remaining Budget: %.2f\n", balance);
}
