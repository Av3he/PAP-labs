
#include <stdio.h>
#include <string.h>

struct Supplier {
    char name[50];
    char email[50];
    char phone[20];
    char town[30];
};

int main()
{
    struct Supplier suppliers[5];

    char searchName[50];
    int found = 0;

    printf("===== SUPPLIER INFORMATION SYSTEM =====\n");

    for (int i = 0; i < 5; i++)
    {
        printf("\nEnter details for Supplier %d\n", i + 1);

        printf("Enter name: ");
        scanf(" %49[^\n]", suppliers[i].name);

        printf("Enter email: ");
        scanf("%49s", suppliers[i].email);

        printf("Enter phone: ");
        scanf("%19s", suppliers[i].phone);

        printf("Enter town: ");
        scanf(" %29[^\n]", suppliers[i].town);
    }

    printf("\nEnter supplier name to search: ");
    scanf(" %49[^\n]", searchName);

    for (int i = 0; i < 5; i++)
    {
        if (strcmp(suppliers[i].name, searchName) == 0)
        {
            printf("\n===== SUPPLIER FOUND =====\n");

            printf("Name: %s\n", suppliers[i].name);
            printf("Email: %s\n", suppliers[i].email);
            printf("Phone: %s\n", suppliers[i].phone);
            printf("Town: %s\n", suppliers[i].town);

            found = 1;
            break;
        }
    }

    if (found == 0)
    {
        printf("\nSupplier not found.\n");
    }

    return 0;
}
